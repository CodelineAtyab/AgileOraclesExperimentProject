# --- Google OAuth (required - the app fails to start without these) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Server ---
SERVER_PORT=8080

# --- OCI Object Storage ---
OCI_REGION=me-riyadh-1
OCI_NAMESPACE=your-tenancy-namespace
OCI_BUCKET_NAME=your-bucket-name

# --- Database, for local runs only ---
DB_URL=your_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# --- Database, for Docker only ---
#ORACLE_PASSWORD=oracle
#DB_APP_USER=leave_app
#DB_APP_PASSWORD=leave_app_pwd

# --- Gemini ---
LLM_API_KEY=your-gemini-api-key
#LLM_MODEL=gemini-flash-latest
